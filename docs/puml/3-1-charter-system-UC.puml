@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam nodesep 28
skinparam ranksep 100
skinparam roundCorner 14

skinparam usecase {
    BackgroundColor #D8E8FF
    BorderColor #5070A0
    ArrowColor #000000
    FontSize 12
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #707070
}
skinparam actor<<external system>> {
    BackgroundColor #FFFDE0
    BorderColor #A09060
}
skinparam rectangle {
    BackgroundColor #FAFCFF
    BorderColor #5070A0
    FontStyle bold
    FontSize 15
}
hide stereotype

actor "Korisnik" as korisnik
actor "Posjetitelj" as posjetitelj
actor "Klijent" as klijent
actor "Djelatnik" as djelatnik
actor "Voditelj" as voditelj
actor "Administrator" as admin

actor "Google\n(prijava, OAuth 2.0)" as google <<external system>>
actor "Kartografski servis\n(Thunderforest)" as maps <<external system>>
actor "Meteorološki\nservis" as meteo <<external system>>
actor "Servis za slanje\ne-pošte" as mail <<external system>>

' Svi konkretni akteri nasljeđuju zajednički akter Korisnik
korisnik <|-- posjetitelj
korisnik <|-- klijent
korisnik <|-- djelatnik
korisnik <|-- voditelj
korisnik <|-- admin

rectangle "Charterly – sustav za charter poslovanje" {
    usecase "UC-011: Pregled statistike\ni izvoz izvještaja" as UC11
    usecase "UC-010: Upravljanje flotom,\ncjenicima i nedostupnošću" as UC10
    usecase "UC-009: Obrada rezervacija i\ndodjela djelatnika" as UC9
    usecase "UC-008: Upravljanje korisnicima\ni specijalnostima" as UC8
    usecase "UC-007: Pregled rasporeda\npreuzimanja i povrata" as UC7
    usecase "UC-006: Izmjena i otkazivanje\nvlastite rezervacije" as UC6
    usecase "UC-005: Pregled vlastitih\nrezervacija" as UC5
    usecase "UC-004: Izrada zahtjeva\nza rezervaciju" as UC4
    usecase "UC-003: Pregled detalja plovila,\nkarte i vremenske prognoze" as UC3
    usecase "UC-002: Pretraživanje i\nfiltriranje plovila" as UC2
    usecase "UC-001: Prijava u sustav\nputem Google računa" as UC1
}

korisnik --> UC2
korisnik --> UC3
UC3 --> maps
UC3 --> meteo

posjetitelj --> UC1
UC1 --> google

klijent --> UC4
klijent --> UC5
klijent --> UC6
UC6 --> mail

djelatnik --> UC7

admin --> UC8
admin --> UC9
UC9 --> mail
admin --> UC10
admin --> UC11

voditelj --> UC11

@enduml
