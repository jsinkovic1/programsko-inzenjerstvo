@startuml
title Charterly – komponente sustava

skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam ArrowColor #212529
skinparam nodesep 40
skinparam ranksep 60

skinparam component {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

skinparam component<<planirano>> {
    BackgroundColor #F8F9FA
    BorderColor #6C757D
    BorderStyle dashed
    FontColor #495057
}

skinparam component<<vanjski>> {
    BackgroundColor #FFFDE0
    BorderColor #A09060
}

skinparam database {
    BackgroundColor #FFF3CD
    BorderColor #212529
}

' ==============================================================================
' Granica sustava i unutarnje komponente
' ==============================================================================

rectangle "Charterly – sustav za charter poslovanje" {

  component "Web-klijent\n(React SPA)" as Web

  rectangle "Poslužiteljska aplikacija (ASP.NET Core Web API)" {
    component "REST API\n(kontroleri)" as API
    component "Autentifikacija\n(Google prijava, JWT)" as Auth
    component "Katalog i pretraga\nplovila" as Katalog
    component "Rezervacije\n(izračun iznosa, statusi)" as Rez <<planirano>>
    component "Upravljanje flotom\ni cjenikom" as Flota <<planirano>>
    component "Korisnici\ni uloge" as Korisnici <<planirano>>
    component "Raspored\npreuzimanja i povrata" as Raspored <<planirano>>
    component "Statistika\ni izvoz CSV" as Stat <<planirano>>
    component "Obavijesti\n(e-pošta)" as Obavijesti <<planirano>>
    component "Vremenska\nprognoza" as Prognoza <<planirano>>
    component "Završetak najma\n(pozadinski posao)" as Zavrsetak <<planirano>>
    component "Pristup podacima\n(EF Core, AppDbContext)" as Data
  }

  database "PostgreSQL\n(btree_gist)" as DB
}

' ==============================================================================
' Vanjski sustavi
' ==============================================================================

component "Google\n(OAuth 2.0)" as Google <<vanjski>>
component "Thunderforest\n(kartografske pločice)" as Maps <<vanjski>>
component "Servis za e-poštu\n(još nije odabran)" as Mail <<vanjski>>
component "Meteorološki servis\n(još nije odabran)" as Meteo <<vanjski>>

' ==============================================================================
' Ovisnosti i sučelja
' ==============================================================================

Web --> API : HTTPS, JSON (REST),\nkolačić ACCESS_TOKEN
Web --> Maps : kartografske pločice\n(Leaflet)
Web ..> Google : preusmjeravanje\nna prijavu

API --> Auth : prijava, identitet\ni uloga korisnika
API --> Katalog : plovila, luke,\nfiltar i pretraga
API --> Rez : izrada, izmjena,\npotvrda, otkazivanje
API --> Flota : plovila, luke, usluge,\noprema, nedostupnost
API --> Korisnici : uloge, specijalnosti,\naktivnost računa
API --> Raspored : potvrđene rezervacije\nza razdoblje
API --> Stat : pokazatelji\ni CSV datoteka
API --> Prognoza : prognoza za luku\ni razdoblje

Auth --> Google : autorizacijski kod,\nidentitet korisnika
Auth --> Data : pronalazak ili stvaranje\nračuna pri prvoj prijavi

Rez --> Obavijesti : promjena statusa\n(nakon pohrane)
Obavijesti --> Mail : potvrda i\notkazivanje
Prognoza --> Meteo : koordinate luke,\nrazdoblje

Katalog --> Data
Rez --> Data
Flota --> Data
Korisnici --> Data
Raspored --> Data
Stat --> Data
Obavijesti --> Data : ishod slanja
Zavrsetak --> Data : POTVRDENA → ZAVRSENA\nza istekle najmove

Data --> DB : SQL (Npgsql)

legend right
  Plava komponenta: implementirano (stanje sredinom projekta)
  Siva iscrtkana komponenta: planirano
  Žuta komponenta: vanjski servis
endlegend
@enduml
